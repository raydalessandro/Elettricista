{
  "name": "elettricista",
  "version": "0.3.0",
  "private": true,
  "description": "Due corsi, un capitolo alla settimana: Fase Neutro Terra (impianto elettrico di casa) e Sfera Cilindro Asse (il banco di un negozio di ottica).",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "standard": "tsx scripts/standard.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run standard && npm test",
    "build:artifact": "tsx scripts/build-artifact.ts",
    "packets": "tsx scripts/packets.ts",
    "packets:ottica": "tsx scripts/packets-ottica.ts"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/jersey-10": "^5.3.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
